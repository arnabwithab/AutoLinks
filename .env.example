# API Keys
GROQ_API_KEY=your_groq_api_key_here
QDRANT_API_KEY=your_qdrant_cloud_api_key_here

# Qdrant
QDRANT_URL=https://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.us-west-1-0.aws.cloud.qdrant.io
QDRANT_COLLECTION=articles

# HF Models Space (GLiNER + MiniLM inference)
MODELS_SPACE_URL=https://eros483-autolinks-models.hf.space
HF_TOKEN=hf_your_huggingface_token_here

# Application
APP_NAME=AutoLinks
PORT=8000
EMBEDDING_MODEL=all-MiniLM-L6-v2
RERANK_ALPHA=0.7
FRONTEND_URL=http://localhost:3000,https://autolinks.vercel.app
DEBUG=false
DRY_RUN=false
# Only set ALLOW_PRIVATE_FETCH=true for local crawling of localhost/private hosts.
ALLOW_PRIVATE_FETCH=false
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Groq Judge
GROQ_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=llama-3.3-70b-versatile

# Redis (Upstash) for async ingestion job queue
REDIS_URL=rediss://default:your_upstash_password@your_upstash_host.upstash.io:6379

# Distributed stack (branch feat/distributed-system only; ignored on main/Render)
# hf = current HF Space backend; sagemaker once the endpoint is warm.
MODELS_BACKEND=hf
SAGEMAKER_ENDPOINT=
SERVICE_ROLE=all

# Clerk Authentication
# The server refuses to start if CLERK_SECRET_KEY is unset unless
# AUTH_DISABLED=true is set explicitly (never do that in production).
CLERK_SECRET_KEY=your_clerk_secret_key_here
VITE_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
AUTH_DISABLED=false
