# ----- distributed image: api + worker binaries @ backend/Dockerfile.distributed -----
# Branch-only. backend/Dockerfile stays the Render image; this one feeds ECR.
# One image, two roles: ECS api tasks run /api (default CMD),
# worker tasks override command to ["/worker"].
FROM golang:1.25-alpine AS builder
WORKDIR /app
COPY backend/go.mod backend/go.sum ./
RUN go mod download
COPY backend/ ./
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /api ./cmd/api \
 && CGO_ENABLED=0 go build -ldflags="-s -w" -o /worker ./cmd/worker

FROM alpine:3.21
RUN apk add --no-cache ca-certificates tzdata
COPY --from=builder /api /api
COPY --from=builder /worker /worker
EXPOSE 8000
CMD ["/api"]
